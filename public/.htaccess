# ============================================================
#  Proplan Klima — statický export Next.js (Forpsi / Apache)
#  Soubor se kopíruje z public/ do out/ při `npm run build`.
# ============================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS ---------------------------------------------------------
  # ODKOMENTOVAT AŽ PO VYDÁNÍ CERTIFIKÁTU ve Forpsi administraci.
  # Dokud doména nemá platný certifikát, tenhle blok web znepřístupní.
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^(.*)$ https://www.proplan-klima.cz/$1 [R=301,L]

  # --- proplan-klima.cz -> www.proplan-klima.cz ----------------------
  RewriteCond %{HTTP_HOST} ^proplan-klima\.cz$ [NC]
  RewriteRule ^(.*)$ http://www.proplan-klima.cz/$1 [R=301,L]

  # --- pozůstatky po WordPressu ------------------------------------
  # Jediná zaindexovaná stránka starého webu byla "/", zbytek byly výchozí
  # ukázkové adresy WP. Ať na nich lidé i roboti skončí na titulce.
  RewriteRule ^sample-page/?$ / [R=301,L]
  RewriteRule ^category/ / [R=301,L]
  RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/ / [R=301,L]
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php) / [R=301,L]

  # --- /kontakt -> /kontakt/ (build běží s trailingSlash: true) ------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

# --- Komprese --------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# --- Cache -----------------------------------------------------------
# /_next/static/* má hash v názvu -> smí se cachovat natrvalo.
# HTML se nesmí cachovat, jinak lidem zůstane stará verze webu.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 hour"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 month"
  ExpiresByType image/jpeg            "access plus 1 month"
  ExpiresByType image/png             "access plus 1 month"
  ExpiresByType image/webp            "access plus 1 month"
  ExpiresByType font/woff2            "access plus 1 year"
</IfModule>

# --- Bezpečnostní hlavičky ------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
