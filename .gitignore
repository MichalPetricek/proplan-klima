# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# .env je záměrně verzovaný: build na GitHub Pages z něj bere veřejné
# NEXT_PUBLIC_* proměnné (URL projektu + publishable key).
# Tajné klíče patří výhradně do .env.local, který se necommituje.
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# zálohy stažené z Forpsi FTP
/backups/
